{
  "name": "genogram-editor",
  "version": "1.0.0",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "require": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./styles.css": "./dist/styles.css"
  },
  "files": [
    "dist",
    "src/ui/styles.css"
  ],
  "scripts": {
    "build": "tsc && vite build && npm run copy-css",
    "copy-css": "powershell -Command \"Copy-Item src/ui/styles.css dist/styles.css\"",
    "prepublishOnly": "npm run build"
  },
  "devDependencies": {
    "typescript": "^5.6.0",
    "vite": "^5.4.0",
    "@types/node": "^20.0.0"
  }
}